# Ambiente da aplicação: development | testing | production
APP_ENV=development

# Chave secreta Flask (mude para valor aleatório forte em produção)
SECRET_KEY=change-me-use-secrets-token-hex-32

# URL de conexão MySQL
# Formato: mysql+pymysql://usuario:senha@host:3306/petgo
DATABASE_URL=mysql+pymysql://petgo:senha@127.0.0.1:3306/petgo

# URL pública da aplicação (sem barra final)
PUBLIC_BASE_URL=https://seu-dominio.com

# AWS
AWS_REGION=us-east-1
MEDIA_BUCKET=petgo-media-privado
BACKUP_BUCKET=petgo-backups-privado

# SMTP (use sandbox/mailtrap em desenvolvimento)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@petgo.com.br

# Chave de cifragem de vouchers (base64 de 32 bytes)
# Gere com: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
VOUCHER_ENCRYPTION_KEY=
