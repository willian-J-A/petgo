[Unit]
Description=PetGo Flask Application (Gunicorn)
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=notify
User=petgo
Group=petgo
WorkingDirectory=/opt/petgo
EnvironmentFile=/etc/petgo/petgo.env
ExecStart=/opt/petgo/venv/bin/gunicorn \
    --workers 2 \
    --worker-class sync \
    --timeout 30 \
    --bind unix:/run/petgo/gunicorn.sock \
    --pid /run/petgo/gunicorn.pid \
    --access-logfile /var/log/petgo/access.log \
    --error-logfile /var/log/petgo/error.log \
    --log-level info \
    wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
# Portas do banco e Gunicorn nunca abertas ao exterior (R10)
# Nginx faz proxy via socket Unix

[Install]
WantedBy=multi-user.target
